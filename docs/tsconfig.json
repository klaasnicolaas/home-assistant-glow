{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Keep this in sync with @docusaurus/tsconfig. It is inlined because that
  // config still uses the deprecated TypeScript 6 baseUrl option.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  }
}
